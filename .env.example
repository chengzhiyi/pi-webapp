# Set these in the environment of the Pi process (Pi does not automatically load this file).
# Reporting is disabled by default. A DSN alone does not enable it.
# Explicitly set PI_WEB_SENTRY_ENABLED=true only when intentionally opting in.
# An explicitly blank common DSN disables both sides unless overridden below.
PI_WEB_SENTRY_DSN=https://070c0b7c5ac18d940c294e63ecfa0793@o4506663318716416.ingest.us.sentry.io/4512191040716800
# Optional separate destinations; blank explicitly disables that side.
# PI_WEB_SENTRY_BROWSER_DSN=
# PI_WEB_SENTRY_NODE_DSN=
PI_WEB_SENTRY_ENABLED=false
PI_WEB_SENTRY_ENVIRONMENT=production

# Build/CI only. Never expose the auth token to the browser or publish it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional overrides for separate browser / extension projects:
# SENTRY_BROWSER_PROJECT=
# SENTRY_NODE_PROJECT=
