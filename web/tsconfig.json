{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../src/host/client/**/*.ts", "../src/host/client/**/*.tsx", "../src/plugins/builtin/*/client/**/*.ts", "../src/plugins/builtin/*/client/**/*.tsx"]
}
