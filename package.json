{
  "name": "pi-webapp",
  "version": "0.1.11",
  "type": "module",
  "description": "A browser interface for Pi with live chat, workspaces, models, and attachments",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhiyi/pi-webapp.git"
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-webapp": "./bin/pi-webapp.mjs"
  },
  "pi": {
    "image": "https://cdn.jsdelivr.net/npm/pi-webapp@0.1.11/assets/cover-webapp.png",
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "assets/cover-webapp.png",
    "bin",
    "dist",
    "web/dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "web/src/ui/shared/LICENSE.txt",
    "docs/sentry.md",
    "docs/sentry-triage.md"
  ],
  "scripts": {
    "start": "npm run build && node bin/pi-webapp.mjs",
    "status": "node bin/pi-webapp.mjs status",
    "stop": "node bin/pi-webapp.mjs stop",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "node --import ./test/setup-env.mjs --experimental-strip-types --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs browser",
    "build:extension": "node scripts/build.mjs node",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run build && npm run test",
    "build:sentry": "node scripts/build.mjs all --sentry",
    "verify:package": "node scripts/verify-sentry-release.mjs --package-only",
    "verify:sentry": "node scripts/verify-sentry-release.mjs --live",
    "sentry:triage": "node scripts/sentry-triage.mjs",
    "test:browser": "playwright test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@chengzhiyi/pi-web-protocol": "0.1.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@playwright/test": "1.63.0",
    "@sentry/esbuild-plugin": "5.4.0",
    "@sentry/vite-plugin": "5.4.0",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.19.19",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "micromark-util-types": "^2.0.2",
    "typescript": "7.0.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@sentry/core": "11.4.0",
    "@sentry/node": "11.4.0",
    "@sentry/react": "11.4.0",
    "@shikijs/langs": "^4.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "katex": "^0.16.47",
    "lexical": "0.49.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "simple-icons": "^16.31.0"
  }
}
