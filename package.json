{
  "name": "pi-webapp",
  "version": "0.1.52",
  "type": "module",
  "piWebappDesktopProtocol": 1,
  "piWebappDataVersion": 1,
  "piWebappHostedRuntime": {
    "protocol": 2,
    "runtimeProtocol": 1,
    "pairJournal": 1,
    "ownershipProtocol": 2,
    "capabilities": ["state", "workspace", "legacy", "panels", "messages"]
  },
  "description": "A browser interface for Pi with live chat, workspaces, models, and attachments",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhiyi/pi-webapp.git"
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-webapp": "./bin/pi-webapp.mjs"
  },
  "pi": {
    "image": "https://cdn.jsdelivr.net/npm/pi-webapp@0.1.39/assets/cover-webapp.png",
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "assets/cover-webapp.png",
    "assets/readme",
    "bin",
    "desktop/managed-release.mjs",
    "desktop/stop-outcome.mjs",
    "desktop/launcher-handoff.mjs",
    "desktop/release-version.mjs",
    "desktop/check-pty.cjs",
    "dist",
    "web/dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "web/src/ui/shared/LICENSE.txt",
    "docs/sentry.md",
    "docs/sentry-triage.md",
    "docs/desktop.md",
    "docs/desktop-testing.md",
    "docs/diagrams.md",
    "docs/hosted-*.md",
    "scripts/prepare-terminal.mjs"
  ],
  "scripts": {
    "start": "npm run build && node bin/pi-webapp.mjs",
    "dev": "node bin/pi-webapp.mjs stop --force && npm run build && node bin/pi-webapp.mjs start",
    "status": "node bin/pi-webapp.mjs status",
    "stop": "node bin/pi-webapp.mjs stop",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "test": "node --import ./test/setup-env.mjs --experimental-strip-types --test --test-concurrency=4 test/*.test.ts && npm run test:desktop",
    "test:desktop": "node --test desktop/test/*.test.mjs",
    "test:quick": "node --import ./test/setup-env.mjs --import ./test/setup-quick.mjs --experimental-strip-types --test --test-concurrency=4 test/*.test.ts",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs",
    "desktop:sync-runtime": "node scripts/sync-desktop-runtime.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:start": "electron desktop",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "desktop:smoke:handoff": "node scripts/smoke-desktop-handoff.mjs",
    "desktop:smoke:legacy": "node scripts/smoke-desktop-legacy.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:prepare-build": "node scripts/prepare-desktop-build.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs browser",
    "build:extension": "node scripts/build.mjs node",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run build && npm run test",
    "build:sentry": "node scripts/build.mjs all --sentry",
    "verify:package": "node scripts/verify-sentry-release.mjs --package-only",
    "verify:sentry": "node scripts/verify-sentry-release.mjs --live",
    "sentry:triage": "node scripts/sentry-triage.mjs",
    "test:browser": "playwright test",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:check": "npm --prefix docs run check",
    "postinstall": "node scripts/prepare-terminal.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@chengzhiyi/pi-web-protocol": "0.1.1",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@playwright/test": "1.64.1",
    "@sentry/esbuild-plugin": "11.10.0",
    "@sentry/vite-plugin": "11.10.0",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "micromark-util-types": "^2.0.2",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lexical/history": "0.53.0",
    "@lexical/plain-text": "0.53.0",
    "@lezer/highlight": "1.2.5",
    "@sentry/core": "11.10.0",
    "@sentry/node": "11.10.0",
    "@sentry/react": "11.10.0",
    "@shikijs/langs": "^4.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "cross-spawn": "^7.0.6",
    "katex": "^0.19.1",
    "lexical": "0.53.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.3.1",
    "simple-icons": "^16.31.0",
    "undici": "7.30.1"
  }
}
