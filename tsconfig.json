{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["src/adapters/**/*.ts", "src/host/server/**/*.ts", "src/platform/**/*.ts", "src/contracts/**/*.ts", "src/plugins/builtin/*/server/**/*.ts", "src/plugins/builtin/*/contract/**/*.ts", "test/**/*.ts"]
}
